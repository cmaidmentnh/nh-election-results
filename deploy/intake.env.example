# Copy to /opt/nh-election-results/intake.env and fill in. chmod 600.

ANTHROPIC_API_KEY=sk-ant-...

# --- Email -----------------------------------------------------------------
# results@electhouserepublicans.com is a Google Group. The mailbox below is a
# member of it, so every clerk report lands here. Use a Google app password,
# not the account password.
INTAKE_IMAP_USER=chris@electhouserepublicans.com
INTAKE_IMAP_PASSWORD=
INTAKE_GROUP_ADDRESS=results@electhouserepublicans.com

# --- Signal ----------------------------------------------------------------
SIGNAL_BOT_NUMBER=+1XXXXXXXXXX
INTAKE_SIGNAL_GROUP_NAME=
# Where "needs review" pings go - a phone number, or a group id.
INTAKE_NOTIFY_TARGET=

# --- Policy ----------------------------------------------------------------
INTAKE_YEAR=2026
INTAKE_ELECTION_TYPE=state_primary
INTAKE_AUTO_APPLY=1
INTAKE_MIN_CONFIDENCE=0.85
# Store but do not publish anything before polls close.
INTAKE_OPEN_AFTER=2026-09-08T19:00:00
